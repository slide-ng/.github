# The one place that names the GitHub organization for the scripts in this repo.
# "slide-ng" is a placeholder. To use the real name, change it here and run
# scripts/set-org.sh <new-name> to rewrite the links in the markdown and yaml files.
ORG=slide-ng

# The repositories of the organization, in the order the scripts visit them.
REPOS="slide.ng themes starter docs docker vscode-extension skills"
